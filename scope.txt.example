# Example scope file for --scope / --strict-scope.
# One entry per line. Blank lines and lines starting with # are ignored.
#
# Bare domain: matches itself AND any subdomain
example.com

# Explicit wildcard: matches subdomains only, NOT the bare apex
*.staging.example.com

# Specific subdomains
api.example.com
admin.example.com

# IP literals (exact match only)
203.0.113.10
2001:db8::1
